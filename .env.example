# ========================================================================
# LLM Backend Configuration
# ========================================================================
# Choose which LLM backend to use: 'ollama', 'lmstudio', 'nim', or 'gemini'
LLM_BACKEND=lmstudio

# Local LLM Backends
# ────────────────────────────────────────────────────────────────────

# Ollama Configuration (if LLM_BACKEND=ollama)
# Run locally: ollama serve
# Then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# LM Studio Configuration (if LLM_BACKEND=lmstudio)
# Download from: https://lmstudio.ai
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=google/gemma-4-26b-a4b

# Cloud LLM Backends
# ────────────────────────────────────────────────────────────────────

# NVIDIA NIM Configuration (if LLM_BACKEND=nim)
# Get free API key from: https://build.nvidia.com/
# Supports various models: meta/llama-3.1-70b-instruct, nvidia/nemotron-4-340b-instruct, etc.
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# Google Gemini Configuration (if LLM_BACKEND=gemini)
# Get free API key from: https://ai.google.dev/
# Supports: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash, etc.
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# LLM Generation Parameters
# ────────────────────────────────────────────────────────────────────
# Maximum tokens to generate per exchange
LLM_MAX_TOKENS=150
# Creativity level (0.0-1.0, higher = more creative/random)
LLM_TEMPERATURE=0.7
# Request timeout in seconds
LLM_TIMEOUT=60.0

# File System Paths
# ────────────────────────────────────────────────────────────────────
# Directory for character JSON files
CHARACTERS_DIR=characters
# Directory for output (TTS audio, logs)
OUTPUTS_DIR=outputs

# Gradio UI Configuration
# ────────────────────────────────────────────────────────────────────
# Server binding address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
GRADIO_SERVER_NAME=127.0.0.1
# Server port
GRADIO_SERVER_PORT=7860
